{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CanbanVoimaxHarness",
  "version": "0.1.0",
  "identifier": "com.voimax.cvh",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CanbanVoimaxHarness",
        "x": -1800,
        "y": 250,
        "width": 1600,
        "height": 950,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
