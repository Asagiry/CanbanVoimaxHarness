  "toolCustomSchemas": {
    "advance_task": {
      "function": {
        "description": "Advance task to the next sequential pipeline stage or transition to a specific stage (stage_id / target_stage). CRITICAL: All TODO items must be fully completed before calling. Requires comprehensive summary of completed work and verification proof.",
        "name": "advance_task",
        "parameters": {
          "properties": {
            "stage_id": {
              "description": "Target pipeline stage ID (e.g. 'review', 'retro', 'ready'). Defaults to sequential next stage.",
              "type": "string"
            },
            "summary": {
              "description": "Comprehensive summary of modifications, sensor results, and verification proof.",
              "type": "string"
            }
          },
          "type": "object"
        },
        "aliases": [
          "move_task",
          "move_task_stage",
          "advance_stage",
          "next_stage"
        ]
      },
      "type": "function"
    }
