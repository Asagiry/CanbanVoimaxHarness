{
  "name": "CanbanVoimaxHarness",
  "version": "0.1.0",
  "description": "Desktop Agentic IDE and Orchestrator built on Rust, Tauri v2, and React",
  "activePipeline": "default-engineering",
  "defaultModel": "gemini-3.8-flash-high",
  "apiBaseUrl": "http://127.0.0.1:8045/v1",
  "providers": {
    "antigravity": {
